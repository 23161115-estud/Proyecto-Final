# Copia este archivo a application.properties y llena los valores. application.properties NO se sube a Git.
spring.application.name=oaxinvest
server.port=8080

# --- Base de datos MySQL (no MariaDB). La BD se crea una vez con database/00_create_database.sql ---
spring.datasource.url=jdbc:mysql://localhost:3306/simulador_oaxaca?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
spring.datasource.username=
spring.datasource.password=

# --- JPA / Flyway: las tablas SOLO las crea Flyway ---
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.default_batch_fetch_size=50
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=3MB

# --- JWT (secreto de minimo 32 caracteres; generalo con: openssl rand -base64 48) ---
app.jwt.secret=
app.jwt.expiration-minutes=120

# --- URLs ---
app.frontend-url=https://tu-dominio.com
app.cors.allowed-origins=http://localhost:5173,https://tu-dominio.com

# --- Correo: Postfix local en el VPS (JavaMailSender) ---
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000
app.mail.from=no-reply@tu-dominio.com

# --- Archivos ---
app.upload-dir=/var/oaxinvest/uploads
app.pdf-dir=/var/oaxinvest/pdfs

# --- Twilio (SMS y WhatsApp) ---
app.twilio.account-sid=
app.twilio.auth-token=
app.twilio.sms-from=
# Sandbox de WhatsApp de Twilio: whatsapp:+14155238886
app.twilio.whatsapp-from=whatsapp:+14155238886

# --- WhatsApp: proveedor (twilio | meta) ---
app.whatsapp.provider=twilio
# WhatsApp Cloud API de Meta (solo si el proveedor es meta)
app.meta.whatsapp.token=
app.meta.whatsapp.phone-number-id=
app.meta.whatsapp.api-version=v21.0
# Dejar vacío para texto libre (requiere que el destinatario haya escrito al número de prueba en las últimas 24 h).
# Para la plantilla de prueba de Meta usar: hello_world
app.meta.whatsapp.template=
app.meta.whatsapp.template-lang=en_US
# Si Meta responde 131030 aunque el número esté en la lista permitida, probar true (52 1XXXXXXXXXX)
app.meta.whatsapp.mx-add-1=false

# --- Inicio de sesion con Google y Facebook (opcional; el boton se oculta si queda vacio) ---
# Google: Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicacion web)
app.google.client-id=
# Facebook: developers.facebook.com > tu app > Configuracion > Basica (ID e Identificador secreto)
app.facebook.app-id=
app.facebook.app-secret=

# --- OpenAI (opcional; si queda vacio se usa un analisis local de respaldo) ---
app.openai.api-key=
app.openai.model=gpt-4o-mini

# --- IA: proveedor (openai | gemini). Si la clave del proveedor elegido queda vacia se usa el analisis local ---
app.ai.provider=openai
# Gemini con clave de Google AI Studio (solo si el proveedor es gemini)
app.gemini.api-key=
app.gemini.model=gemini-4-hydrogen
