meta {
  name: Listar simulaciones paginado + filtro
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/simulations?page=0&size=5&q=oaxaca&sort=roi,desc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("trae paginacion del servidor", function() {
    expect(res.body.content).to.be.an("array");
    expect(res.body.size).to.equal(5);
  });
}
