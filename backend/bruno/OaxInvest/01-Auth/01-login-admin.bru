meta {
  name: Login admin (obtiene token JWT)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@oaxinvest.mx",
    "password": "Admin#2026"
  }
}

assert {
  res.status: eq 200
}

vars:post-response {
  token: res.body.token
}

tests {
  test("devuelve un JWT", function() {
    expect(res.body.token).to.be.a("string");
    expect(res.body.tokenType).to.equal("Bearer");
  });
}
