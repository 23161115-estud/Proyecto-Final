meta {
  name: Registro de cliente nuevo
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Cliente Bruno",
    "email": "bruno@test.com",
    "password": "Bruno#2026",
    "phone": "+529511234567"
  }
}

assert {
  res.status: eq 201
}
