meta {
  name: Perfil con token (ruta protegida)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("regresa el usuario autenticado", function() {
    expect(res.body.email).to.be.a("string");
  });
}
